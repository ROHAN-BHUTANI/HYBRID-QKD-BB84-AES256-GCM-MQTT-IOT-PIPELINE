# ==============================================================================
# Environment Configuration for Hybrid BB84 QKD + AES-256-GCM IoT Security Pipeline
# ==============================================================================

# Quantum Simulation Parameters
NUM_QUBITS=512
SAMPLE_FRACTION=0.25
QBER_THRESHOLD=0.11
ENABLE_EVE=False
EVE_INTERCEPT_PROB=1.0

# Cryptography Settings
AES_KEY_SIZE_BYTES=32
AES_GCM_NONCE_SIZE_BYTES=12
AES_GCM_TAG_SIZE_BYTES=16

# MQTT Transport Configuration
USE_SIMULATED_BROKER=True
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_DATA=iot/secure/data
MQTT_TOPIC_STATUS=iot/secure/status

# Application & Database Settings
DATABASE_PATH=database/iot_cloud.db
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=False
